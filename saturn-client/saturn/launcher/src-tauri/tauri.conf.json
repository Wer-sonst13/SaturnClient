{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saturn",
  "version": "1.0.0",
  "identifier": "dev.saturn.launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Saturn", "width": 820, "height": 520, "resizable": false, "center": true, "theme": "Dark" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
