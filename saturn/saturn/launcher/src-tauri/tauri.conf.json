{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saturn",
  "version": "2.0.0",
  "identifier": "dev.saturn.launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Saturn", "width": 1120, "height": 720, "minWidth": 980, "minHeight": 620,
        "resizable": true, "center": true, "decorations": false, "theme": "Dark" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
